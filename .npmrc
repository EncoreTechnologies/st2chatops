# Supply-chain guardrails (npm >= 11.10), the same as st2web's.
# Recent npm compromises shipped payloads in install scripts and were pulled from the registry
# within hours to days. No package in this tree needs an install script.
ignore-scripts=true
# Only resolve versions that have been public for at least 14 days.
min-release-age=14
# Dependencies come from the registry, or from vendor/ (hubot-stackstorm, Encore's fork), never
# from git URLs.
allow-git=none
engine-strict=true
# Security fixes reviewed by hand (tarball diffed against the previous release, same publisher,
# no new dependencies or scripts) and pinned exactly via "overrides" in package.json. Drop
# each line, and its override pin, once the version is older than min-release-age:
#   body-parser 2.4.0 (2026-10-22, GHSA-27r3-jxmh-p828)              -> 2026-11-05
#   follow-redirects 1.16.2 (2026-10-25, GHSA-mrwp-f3q8-3g9p)        -> 2026-11-08
min-release-age-exclude[]=body-parser
min-release-age-exclude[]=follow-redirects
